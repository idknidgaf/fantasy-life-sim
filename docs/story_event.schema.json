  "effect_types": {
    "change_relationship": {
      "doc": "Improve (positive amount) or damage (negative) an existing acquaintance. Not an acquaintance: nothing changes.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "maximum": 100,
            "minimum": -100,
            "title": "Amount",
            "type": "integer"
          },
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          }
        },
        "required": [
          "npc",
          "amount"
        ],
        "title": "ChangeRelationshipParams",
        "type": "object"
      }
    },
    "complete_event": {
      "doc": "Mark an event as completed without a choice (closes an open instance, or records a finished one).",
      "params": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "minLength": 1,
            "title": "Event",
            "type": "string"
          }
        },
        "required": [
          "event"
        ],
        "title": "EventRefParams",
        "type": "object"
      }
    },
    "end_relationship": {
      "doc": "End the personal relationship with an acquaintance. The character is not deleted; family and Notable status stay.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          }
        },
        "required": [
          "npc"
        ],
        "title": "NpcParams",
        "type": "object"
      }
    },
    "establish_acquaintance": {
      "doc": "The player has personally met this character and now has a relationship with them (an Acquaintance). Only this\n    outcome makes one. Repeating it changes nothing; hostile, refusing or dead characters are not befriended.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "closeness": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Closeness"
          },
          "kind": {
            "anyOf": [
              {
                "enum": [
                  "friend",
                  "partner",
                  "rival"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Kind"
          },
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          }
        },
        "required": [
          "npc"
        ],
        "title": "EstablishParams",
        "type": "object"
      }
    },
    "grant_trait": {
      "doc": "Give the character a trait. Reuses the game's trait rules: already owned or unmet prerequisites is a no-op.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "trait": {
            "minLength": 1,
            "title": "Trait",
            "type": "string"
          }
        },
        "required": [
          "trait"
        ],
        "title": "GrantTraitParams",
        "type": "object"
      }
    },
    "increment_flag": {
      "doc": "Add amount (default 1) to a numeric flag. An unset flag starts at 0; a non-numeric flag is an error.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "default": 1,
            "title": "Amount"
          },
          "flag": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Flag",
            "type": "string"
          }
        },
        "required": [
          "flag"
        ],
        "title": "IncrementFlagParams",
        "type": "object"
      }
    },
    "increment_npc_flag": {
      "doc": "Add to a numeric flag on a named character (unset starts at 0; a non-numeric flag is an error).",
      "params": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "default": 1,
            "title": "Amount"
          },
          "flag": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Flag",
            "type": "string"
          },
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          }
        },
        "required": [
          "npc",
          "flag"
        ],
        "title": "IncrementNpcFlagParams",
        "type": "object"
      }
    },
    "link_npc": {
      "doc": "Link a named character to `other` (a definition id, or `player`). Repeating it is harmless.",
      "params": {
        "$defs": {
          "RelationshipKind": {
            "enum": [
              "parent",
              "mentor",
              "partner",
              "friend",
              "rival"
            ],
            "title": "RelationshipKind",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/$defs/RelationshipKind"
          },
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          },
          "other": {
            "minLength": 1,
            "title": "Other",
            "type": "string"
          },
          "role": {
            "default": "source",
            "enum": [
              "source",
              "target"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "npc",
          "kind",
          "other"
        ],
        "title": "LinkNpcParams",
        "type": "object"
      }
    },
    "reveal_npc": {
      "doc": "The player hears of or meets a character: they become a Notable Figure. Introduces them if they are not yet in\n    the game (only when the definition's `encounter.conditions` hold). Creates no relationship.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          }
        },
        "required": [
          "npc"
        ],
        "title": "NpcParams",
        "type": "object"
      }
    },
    "set_flag": {
      "doc": "Set a story flag to a bool, number or string.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "flag": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Flag",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "flag",
          "value"
        ],
        "title": "SetFlagParams",
        "type": "object"
      }
    },
    "set_npc_flag": {
      "doc": "Set a story flag on a named character.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "flag": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Flag",
            "type": "string"
          },
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "npc",
          "flag",
          "value"
        ],
        "title": "SetNpcFlagParams",
        "type": "object"
      }
    },
    "set_npc_stance": {
      "doc": "hostile or refused: the character turns on the player or will not see them again. Any acquaintance ends and none\n    can be made. They never become an acquaintance this way. open: restores contact.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          },
          "stance": {
            "enum": [
              "open",
              "hostile",
              "refused"
            ],
            "title": "Stance",
            "type": "string"
          }
        },
        "required": [
          "npc",
          "stance"
        ],
        "title": "StanceParams",
        "type": "object"
      }
    },
    "set_npc_status": {
      "doc": "Change a named character's lifecycle status. An immortal one cannot be killed; the dead stay dead.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cause"
          },
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "deceased",
              "retired"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "npc",
          "status"
        ],
        "title": "SetNpcStatusParams",
        "type": "object"
      }
    },
    "spawn_npc": {
      "doc": "Introduce a named character. A character who already exists is not created again. A new one is created only\n    if the definition's `encounter.conditions` (if any) hold, so authors decide when each character may appear.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "npc": {
            "minLength": 1,
            "title": "Npc",
            "type": "string"
          }
        },
        "required": [
          "npc"
        ],
        "title": "NpcParams",
        "type": "object"
      }
    },
    "start_event": {
      "doc": "Create a pending instance of another event. Its eligibility and lifecycle policy still apply.",
      "params": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "minLength": 1,
            "title": "Event",
            "type": "string"
          }
        },
        "required": [
          "event"
        ],
        "title": "EventRefParams",
        "type": "object"
      }
    }
  },
  "event_file": {
    "$defs": {
      "Choice": {
        "additionalProperties": false,
        "properties": {
          "conditions": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Conditions"
          },
          "effects": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Effects",
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
            "title": "Id",
            "type": "string"
          },
          "locked_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Locked Hint"
          },
          "next_event": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Event"
          },
          "result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "Choice",
        "type": "object"
      },
      "EventDefinition": {
        "additionalProperties": false,
        "properties": {
          "choices": {
            "items": {
              "$ref": "#/$defs/Choice"
            },
            "minItems": 1,
            "title": "Choices",
            "type": "array"
          },
          "compatible_versions": {
            "items": {
              "type": "integer"
            },
            "title": "Compatible Versions",
            "type": "array"
          },
          "conditions": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Conditions"
          },
          "event_type": {
            "default": "event",
            "enum": [
              "event",
              "node"
            ],
            "title": "Event Type",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
            "title": "Id",
            "type": "string"
          },
          "lifecycle": {
            "$ref": "#/$defs/Lifecycle"
          },
          "narrative": {
            "minLength": 1,
            "title": "Narrative",
            "type": "string"
          },
          "npc": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9][a-z0-9_.\\-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Npc"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "trigger": {
            "additionalProperties": true,
            "title": "Trigger",
            "type": "object"
          },
          "version": {
            "default": 1,
            "minimum": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "title",
          "narrative",
          "choices"
        ],
        "title": "EventDefinition",
        "type": "object"
      },
      "Lifecycle": {
